---
import './train-station.scss'

// https://stackoverflow.com/a/59429852/13159492
import '@fortawesome/fontawesome-svg-core/styles.css'
import { config } from '@fortawesome/fontawesome-svg-core'
import { ServiceLineLayout, StationTitle } from '../layouts/train-station/train-station-layout'
import Navbar from '../components/Navbar/Navbar'
import FooterSources from '../components/FooterSources/FooterSources'
import { GlobalAlertsHeader } from '../components/GlobalAlerts/GlobalAlerts'
config.autoAddCss = false

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="shortcut icon" href="/train-icon.png" type="image/x-icon">
		<title>Train Station</title>
	</head>
	<body transition:animate="slide">
		<main>
			<Navbar client:load></Navbar>
			<StationTitle client:load></StationTitle>
			<GlobalAlertsHeader showLoading={false} customer={{
				severity: ['severe']
			}}client:visible></GlobalAlertsHeader>
			<ServiceLineLayout client:visible></ServiceLineLayout>
			<FooterSources></FooterSources>
		</main>
	</body>
</html>
