---
import './scss/index.scss'
import { TrainStationList, TrainStationGPS, TrainNumberSearch } from '../components/TrainStationList/TrainStationList'
import { Map, MapPinSearch, Search } from 'lucide-solid'
import FooterSources from '../components/FooterSources/FooterSources'
import Navbar from '../components/Navbar/Navbar'

import CTA from '../library/CTA'
import type DetailedTrainAlerts from '../library/DetailedTrainAlerts'

const [ stations ] = await CTA.getAllTrainStationRoutes()
const [ trainAlerts, trainAlertsError ] = await CTA.getDetailedTrainAlerts()

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="shortcut icon" href="/train-icon.png" type="image/x-icon">
		<title>Open Transit Chicago</title>
	</head>
	<body>
		<Navbar client:load trainAlerts={trainAlerts}></Navbar>
		<main>
			<header>
				<h1>Open Transit Chicago</h1>
			</header>
			
			<section class="half-size">
				<header>
					<h1>
						<Map size='2rem' />
						Train Stations
					</h1>
				</header>
				<TrainStationList client:load stations={stations!}></TrainStationList>
				
				<header>
					<h1>
						<MapPinSearch size='2rem' />
						Find The Closest Train Station
					</h1>

				</header>
				<TrainStationGPS client:visible stations={stations!}></TrainStationGPS>

				<header>
					<h1>
						<Search size="2rem"/>
						Search by Train Number
					</h1>

				</header>
				<TrainNumberSearch client:visible></TrainNumberSearch>

			</section>

		</main>

		<FooterSources></FooterSources>
	</body>
</html>
